{
  "contractVersion": "1.1.0",
  "name": "Astartes Forge Chapter Artwork Geometry Contract",
  "master": {
    "chapter": "Blood Angels",
    "role": "immutable geometry and composition reference",
    "geometryFile": "config/artwork-master-geometry-v1.1.json"
  },
  "productionCanvas": {
    "width": 2480,
    "height": 3508,
    "orientation": "portrait",
    "fullBleed": true
  },
  "rules": {
    "centralOpening": "must_match_master_silhouette",
    "titleZone": "must_preserve_formal_frozen_title_safe_zone",
    "pointsArea": "must_preserve_formal_frozen_points_safe_zone",
    "outerContour": "closed_and_flush_to_all_edges",
    "chapterDecorationMayVary": true,
    "chapterDecorationMayAlterFunctionalGeometry": false,
    "bakedChapterName": false,
    "contentClippingAllowed": false
  },
  "validation": {
    "thresholds": {
      "maxCentralOpeningMismatchRatio": 0.0015,
      "outerEdgeMinAlpha": 250,
      "maxOuterEdgeNonOpaqueRatio": 0.0,
      "safeZoneMinAlpha": 250,
      "minSafeZoneOpaqueRatio": 0.995,
      "gradientThreshold": 38,
      "maxTitleZoneEdgeRatio": 0.02,
      "maxPointsZoneEdgeRatio": 0.02
    },
    "failureIsBlocking": true
  }
}
